~ rite main
    $g = graph_new(false)

    ~ fn edge($u, $v, $w)
        graph_add_edge($g, $u, $v, $w)
    ~ end

    edge("S", "A", 4)
    edge("S", "B", 2)
    edge("A", "C", 3)
    edge("B", "A", 1)
    edge("B", "D", 4)
    edge("C", "D", 1)
    edge("C", "E", 6)
    edge("D", "E", 2)

    $bfs = graph_bfs($g, "S")
    $dj = graph_dijkstra($g, "S")
    $fw = graph_floyd_warshall($g)

    !say "Graph shortest-path demo"
    !say "input nodes: S,A,B,C,D,E"
    !say "expected bfs from S: [S, A, B, C, D, E]"
    !say "bfs order:"
    !say $bfs

    !say "expected dijkstra S->E distance: 8"
    !say "dijkstra dist to E:"
    !say $dj["E"]

    !say "floyd-warshall S->E:"
    !say $fw["S"]["E"]
~ end
