{
  "comments": {
    "lineComment": "#"
  },
  "wordPattern": "\\$?[_\\p{L}][_\\p{L}\\p{N}]*|-?\\d+(?:\\.\\d+)?",
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    {"open": "{", "close": "}"},
    {"open": "[", "close": "]"},
    {"open": "(", "close": ")"},
    {"open": "\"", "close": "\""}
  ],
  "surroundingPairs": [
    {"open": "{", "close": "}"},
    {"open": "[", "close": "]"},
    {"open": "(", "close": ")"},
    {"open": "\"", "close": "\""}
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*~\\s*(rite|unsafe|fn|if|else|loop|each|while)\\b.*$",
    "decreaseIndentPattern": "^\\s*~\\s*(else|end)\\b.*$"
  },
  "folding": {
    "markers": {
      "start": "^\\s*~\\s*(rite|unsafe|fn|if|loop|each|while)\\b",
      "end": "^\\s*~\\s*end\\b"
    }
  }
}
