~ rite
    $n = 200000
    $reps = 4
    $m1 = {long_key_value_123: 1}
    $m2 = {long_key_value_123: 2}
    $k = "long_key_value_123"
    $m = $m1

    $sum = 0
    $r = 0
    ~ while $r < $reps
        $phase = 0
        ~ while $phase < 2
            ~ if $phase == 0
                $m = $m1
            ~ else
                $m = $m2
            ~ end
            $i = 0
            ~ while $i < $n
                $v = __index($m, $k)
                $sum = $sum + $v
                $v = __index($m, $k)
                $sum = $sum + $v
                $i = $i + 1
            ~ end
            $phase = $phase + 1
        ~ end
        $r = $r + 1
    ~ end

    ^ $sum
~ end
