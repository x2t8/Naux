~ rite
    $n = 200000
    $reps = 5
    $m = {a: 0}
    $k = "a"

    $r = 0
    ~ while $r < $reps
        $i = 0
        ~ while $i < $n
            $tmp = $i + 1
            $__ = __setindex($m, $k, $tmp)
            $tmp = $tmp + 1
            $__ = __setindex($m, $k, $tmp)
            $__ = __setindex($m, $k, $i)
            $i = $i + 1
        ~ end
        $r = $r + 1
    ~ end

    ^ $n
~ end
