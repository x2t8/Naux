~ rite
    $n = 100000
    $reps = 50
    $arr = list_range($n)

    $r = 0
    $total = 0
    ~ while $r < $reps
        $i = 0
        $sum = 0
        ~ while $i < len($arr)
            $sum = $sum + 0
            $sum = $sum + 0
            $sum = $sum + __index($arr, $i)
            $i = $i + 1
        ~ end
        $total = $total + $sum
        $r = $r + 1
    ~ end

    ^ $total
~ end
