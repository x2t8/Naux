~ rite
    $n = 200000
    $reps = 5
    $m = {a: 1}
    $k = "a"

    $sum = 0
    $r = 0
    ~ while $r < $reps
        $i = 0
        ~ while $i < $n
            $v = __index($m, $k)
            $sum = $sum + $v
            $v = __index($m, $k)
            $sum = $sum + $v
            $i = $i + 1
        ~ end
        $r = $r + 1
    ~ end

    ^ $sum
~ end
