~ rite
    $n = 20000
    $reps = 5
    $arr = list_range($n)

    $r = 0
    $total = 0
    ~ while $r < $reps
        $i = 0
        $sum = 0
        ~ while $i < len($arr)
            $v = __index($arr, $i)
            $sum = $sum + $v
            $__ = __setindex($arr, $i, $v + 1)
            $i = $i + 1
        ~ end
        $total = $total + $sum
        $r = $r + 1
    ~ end

    ^ $total
~ end
