~ rite
    $n = read_int()
    $values = []
    ~ loop $n
        $values = queue_push($values, read_int())
    ~ end
    $target = read_int()
    $answer = -1
    $i = 0
    ~ while $i < $n
        ~ if $answer == -1 && $values[$i] == $target
            $answer = $i
        ~ end
        $i = $i + 1
    ~ end
    !say $answer
~ end
