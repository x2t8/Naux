#!/bin/sh
set -eu

# Generated by scripts/render_s1_bootstrap.sh. The archive identity below is
# immutable for one NAUX Learn release; do not turn this into an unpinned
# "latest" downloader.
NAUX_VERSION='@@VERSION@@'
NAUX_TAG='@@TAG@@'
NAUX_ARCHIVE='@@ARCHIVE@@'
NAUX_ARCHIVE_SHA256='@@ARCHIVE_SHA256@@'
NAUX_ARCHIVE_BYTES='@@ARCHIVE_BYTES@@'
NAUX_RELEASE_BASE='https://github.com/x2t8/Naux/releases/download'

fail() {
    printf 'nauxup: %s\n' "$*" >&2
    exit 1
}

need() {
    command -v "$1" >/dev/null 2>&1 || fail "required command is missing: $1"
}

cleanup() {
    if [ -n "${naux_temp_root:-}" ] && [ -d "$naux_temp_root" ]; then
        rm -rf -- "$naux_temp_root"
    fi
}

trap cleanup EXIT
trap 'exit 1' HUP INT TERM
umask 077

[ "$(uname -s)" = 'Linux' ] || fail 'this installer supports Linux only'
case "$(uname -m)" in
    x86_64|amd64) ;;
    *) fail 'this installer supports x86-64 only' ;;
esac

for naux_command in curl mkdir mktemp rm sha256sum tar uname wc; do
    need "$naux_command"
done

naux_temp_root=$(mktemp -d "${TMPDIR:-/tmp}/nauxup.XXXXXXXX") || \
    fail 'cannot create a private temporary directory'
naux_archive_path="$naux_temp_root/$NAUX_ARCHIVE"
naux_checksum_path="$naux_archive_path.sha256"
naux_extract_path="$naux_temp_root/extract"
mkdir -m 0700 -- "$naux_extract_path"

printf 'NAUX Learn %s: downloading the pinned Linux bundle...\n' "$NAUX_VERSION"
curl --fail --silent --show-error --location \
    --proto '=https' --tlsv1.2 --retry 3 --retry-delay 1 \
    --output "$naux_archive_path" \
    "$NAUX_RELEASE_BASE/$NAUX_TAG/$NAUX_ARCHIVE"
curl --fail --silent --show-error --location \
    --proto '=https' --tlsv1.2 --retry 3 --retry-delay 1 \
    --output "$naux_checksum_path" \
    "$NAUX_RELEASE_BASE/$NAUX_TAG/$NAUX_ARCHIVE.sha256"

naux_actual_bytes=$(wc -c < "$naux_archive_path")
[ "$naux_actual_bytes" = "$NAUX_ARCHIVE_BYTES" ] || \
    fail 'downloaded archive size differs from the sealed release identity'

naux_expected_line="$NAUX_ARCHIVE_SHA256  $NAUX_ARCHIVE"
naux_expected_checksum_bytes=$((${#naux_expected_line} + 1))
naux_actual_checksum_bytes=$(wc -c < "$naux_checksum_path")
[ "$naux_actual_checksum_bytes" = "$naux_expected_checksum_bytes" ] || \
    fail 'downloaded checksum file is not canonical'
IFS= read -r naux_checksum_line < "$naux_checksum_path" || \
    fail 'cannot read the downloaded checksum file'
[ "$naux_checksum_line" = "$naux_expected_line" ] || \
    fail 'downloaded checksum identity differs from this installer'

naux_actual_hash=$(sha256sum -- "$naux_archive_path")
naux_actual_hash=${naux_actual_hash%% *}
[ "$naux_actual_hash" = "$NAUX_ARCHIVE_SHA256" ] || \
    fail 'downloaded archive SHA-256 mismatch'

tar --extract --gzip --file "$naux_archive_path" \
    --directory "$naux_extract_path" --no-same-owner --same-permissions
naux_bundle="$naux_extract_path/naux-learn-$NAUX_VERSION-linux-x86_64-gnu"
naux_binary="$naux_bundle/bin/naux"
naux_setup="$naux_bundle/naux-learn-setup"
[ -x "$naux_binary" ] || fail 'verified archive is missing bin/naux'
[ -x "$naux_setup" ] || fail 'verified archive is missing naux-learn-setup'

"$naux_binary" bundle verify "$naux_bundle" >/dev/null || \
    fail 'the extracted NAUX bundle failed its sealed-manifest verification'
[ "$("$naux_binary" --version)" = "naux $NAUX_VERSION" ] || \
    fail 'the extracted executable version differs from this installer'

printf 'NAUX Learn %s: outer checksum and inner manifest verified.\n' "$NAUX_VERSION"
if [ "$#" -gt 0 ]; then
    "$naux_setup" "$@"
else
    [ -r /dev/tty ] || fail \
        'interactive Setup needs a terminal; pass --yes --language <locale>'
    "$naux_setup" </dev/tty
fi
