$ErrorActionPreference = "Stop"
Set-StrictMode -Version 2.0

# Generated by scripts/render_s1_bootstrap.sh. This script is pinned to one
# immutable NAUX Learn release and deliberately does not resolve "latest".
$NauxVersion = '@@VERSION@@'
$NauxTag = '@@TAG@@'
$NauxArchive = '@@ARCHIVE@@'
$NauxArchiveSha256 = '@@ARCHIVE_SHA256@@'
$NauxArchiveBytes = [int64]@@ARCHIVE_BYTES@@
$NauxReleaseBase = 'https://github.com/x2t8/Naux/releases/download'

if ([System.Environment]::OSVersion.Platform -ne [System.PlatformID]::Win32NT) {
    throw 'nauxup supports Windows only'
}
$nativeArchitecture = if ($env:PROCESSOR_ARCHITEW6432) {
    $env:PROCESSOR_ARCHITEW6432
} else {
    $env:PROCESSOR_ARCHITECTURE
}
if ($nativeArchitecture -notin @('AMD64', 'x86_64')) {
    throw 'nauxup supports x86-64 Windows only'
}

$nauxTempRoot = Join-Path ([System.IO.Path]::GetTempPath()) (
    'nauxup-' + [System.Guid]::NewGuid().ToString('N')
)
$archivePath = Join-Path $nauxTempRoot $NauxArchive
$checksumPath = "$archivePath.sha256"
$extractPath = Join-Path $nauxTempRoot 'extract'
$previousSecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol

try {
    New-Item -ItemType Directory -Path $extractPath | Out-Null
    [System.Net.ServicePointManager]::SecurityProtocol =
        $previousSecurityProtocol -bor [System.Net.SecurityProtocolType]::Tls12

    Write-Host "NAUX Learn ${NauxVersion}: downloading the pinned Windows bundle..."
    Invoke-WebRequest -UseBasicParsing -Uri (
        "$NauxReleaseBase/$NauxTag/$NauxArchive"
    ) -OutFile $archivePath
    Invoke-WebRequest -UseBasicParsing -Uri (
        "$NauxReleaseBase/$NauxTag/$NauxArchive.sha256"
    ) -OutFile $checksumPath

    if ((Get-Item -LiteralPath $archivePath).Length -ne $NauxArchiveBytes) {
        throw 'downloaded archive size differs from the sealed release identity'
    }
    $expectedChecksum = "$NauxArchiveSha256  $NauxArchive`n"
    $actualChecksum = [System.IO.File]::ReadAllText($checksumPath)
    if ($actualChecksum -cne $expectedChecksum) {
        throw 'downloaded checksum identity differs from this installer'
    }
    $actualHash = (Get-FileHash -LiteralPath $archivePath -Algorithm SHA256).Hash.ToLowerInvariant()
    if ($actualHash -cne $NauxArchiveSha256) {
        throw 'downloaded archive SHA-256 mismatch'
    }

    Expand-Archive -LiteralPath $archivePath -DestinationPath $extractPath
    $bundle = Join-Path $extractPath "naux-learn-$NauxVersion-windows-x86_64-gnu"
    $binary = Join-Path $bundle 'bin\naux.exe'
    $setup = Join-Path $bundle 'NAUX-Learn-Setup.exe'
    if (-not (Test-Path -LiteralPath $binary -PathType Leaf)) {
        throw 'verified archive is missing bin\naux.exe'
    }
    if (-not (Test-Path -LiteralPath $setup -PathType Leaf)) {
        throw 'verified archive is missing NAUX-Learn-Setup.exe'
    }

    & $binary bundle verify $bundle | Out-Null
    if ($LASTEXITCODE -ne 0) {
        throw 'the extracted NAUX bundle failed its sealed-manifest verification'
    }
    $versionOutput = (& $binary --version | Out-String).TrimEnd("`r", "`n")
    if ($LASTEXITCODE -ne 0 -or $versionOutput -cne "naux $NauxVersion") {
        throw 'the extracted executable version differs from this installer'
    }

    Write-Host "NAUX Learn ${NauxVersion}: outer checksum and inner manifest verified."
    $setupArguments = @()
    if ($env:NAUX_LEARN_INSTALL_LANGUAGE) {
        if ($env:NAUX_LEARN_INSTALL_YES -cne '1') {
            throw 'noninteractive Setup requires NAUX_LEARN_INSTALL_YES=1'
        }
        $setupArguments += @('--yes', '--language', $env:NAUX_LEARN_INSTALL_LANGUAGE)
        if ($env:NAUX_LEARN_INSTALL_PREFIX) {
            $setupArguments += @('--prefix', $env:NAUX_LEARN_INSTALL_PREFIX)
        }
        if ($env:NAUX_LEARN_INSTALL_STATE_DIRECTORY) {
            $setupArguments += @(
                '--state-directory', $env:NAUX_LEARN_INSTALL_STATE_DIRECTORY
            )
        }
    } elseif ($env:NAUX_LEARN_INSTALL_YES -or
        $env:NAUX_LEARN_INSTALL_PREFIX -or
        $env:NAUX_LEARN_INSTALL_STATE_DIRECTORY) {
        throw 'NAUX_LEARN_INSTALL_LANGUAGE is required with noninteractive Setup variables'
    }
    & $setup @setupArguments
    if ($LASTEXITCODE -ne 0) {
        throw "NAUX Learn Setup exited with code $LASTEXITCODE"
    }
}
finally {
    [System.Net.ServicePointManager]::SecurityProtocol = $previousSecurityProtocol
    if (Test-Path -LiteralPath $nauxTempRoot) {
        Remove-Item -LiteralPath $nauxTempRoot -Recurse -Force
    }
}
