~ rite
    $n = 16384
    $reps = 50
    $arr = list_range($n)

    $r = 0
    $sum = 0
    $state = 0
    ~ while $r < $reps
        $i = 0
        ~ while $i < len($arr)
            $v = __index($arr, $i)
            $state = $state + 17
            ~ if $state >= 97
                $state = $state - 97
            ~ end
            ~ if $state < 48
                $sum = $sum + $v
            ~ else
                $sum = $sum - $v
            ~ end
            $i = $i + 1
        ~ end
        $r = $r + 1
    ~ end

    ^ $sum
~ end
